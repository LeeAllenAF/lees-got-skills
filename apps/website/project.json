{
  "name": "website",
  "projectType": "application",
  "root": "apps/website",
  "sourceRoot": "apps/website/src",
  "targets": {
    "dev": {
      "command": "corepack pnpm --filter @alienfish/website dev",
      "cache": false,
      "continuous": true
    },
    "typecheck": {
      "command": "pnpm --filter @alienfish/website typecheck"
    },
    "test": {
      "command": "pnpm --filter @alienfish/website test"
    },
    "build": {
      "command": "pnpm --filter @alienfish/website build",
      "outputs": ["{workspaceRoot}/dist/apps/website"]
    },
    "deploy:check": {
      "command": "corepack pnpm --filter @alienfish/website run deploy:check",
      "cache": false
    },
    "deploy": {
      "command": "corepack pnpm --filter @alienfish/website run deploy",
      "cache": false
    },
    "deploy:staging:check": {
      "command": "corepack pnpm --filter @alienfish/website run deploy:staging:check",
      "cache": false
    },
    "deploy:staging": {
      "command": "corepack pnpm --filter @alienfish/website run deploy:staging",
      "cache": false
    }
  }
}
