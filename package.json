{
  "name": "@alienfish/lees-got-skills",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "devDependencies": {
    "nx": "23.3.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "nx dev website",
    "deploy": "nx run website:deploy",
    "agent:index": "node skills/repository-guidelines/scripts/build-index.mjs",
    "agent:guidelines": "node skills/repository-guidelines/scripts/select-guidelines.mjs",
    "agent:check": "node skills/repository-guidelines/scripts/validate.mjs",
    "agent:adapters": "node skills/repository-guidelines/scripts/generate-adapters.mjs",
    "website:dev": "nx dev website",
    "website:typecheck": "nx typecheck website",
    "website:test": "nx test website",
    "website:build": "nx build website",
    "skills:validate": "nx run-many -t validate --projects=tag:type:skill",
    "skills:package": "nx run-many -t package --projects=tag:type:skill",
    "website:login": "corepack pnpm --filter @alienfish/website exec wrangler login",
    "website:deploy:check": "nx run website:deploy:check",
    "website:deploy": "nx run website:deploy",
    "website:deploy:staging:check": "nx run website:deploy:staging:check",
    "website:deploy:staging": "nx run website:deploy:staging"
  }
}
