{
  "name": "@alienfish/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "cf-types": "wrangler types src/worker-configuration.d.ts",
    "preview": "vite preview",
    "deploy:check": "vite build && wrangler deploy --env=\"\" --dry-run",
    "deploy": "vite build && wrangler deploy --env=\"\"",
    "deploy:staging:check": "vite build && wrangler deploy --env staging --dry-run",
    "deploy:staging": "vite build && wrangler deploy --env staging"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
